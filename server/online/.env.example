# Template only. Fill in the hosting provider's private environment, not Git.
NODE_ENV=production
AGENTFC_DEPLOY_STAGE=production
AGENTFC_API_PORT=4180
AGENTFC_ALLOWED_ORIGINS=capacitor://localhost
AGENTFC_DATABASE_URL=
# Use a known ingress chain only after blocking direct access to Node.
AGENTFC_TRUST_PROXY_HOPS=0

# Native Sign in with Apple. No Supabase service key belongs in the client.
AGENTFC_APPLE_SIGNIN_TEAM_ID=
AGENTFC_APPLE_SIGNIN_KEY_ID=
AGENTFC_APPLE_SIGNIN_KEY_PATH=
# Generate once in a private secret store: 32 random bytes encoded in Base64.
AGENTFC_TOKEN_ENCRYPTION_KEY=

# APNs p8 key, separately enabled for this bundle ID in Apple Developer.
AGENTFC_APNS_TEAM_ID=
AGENTFC_APNS_KEY_ID=
AGENTFC_APNS_KEY_PATH=

# Single Apple transaction environment per deployment. Keep Sandbox games
# isolated from public competitive accounts; see the App Store release guide.
AGENTFC_APPLE_ENVIRONMENT=Production
AGENTFC_COMMERCE_ENABLED=true
AGENTFC_ADMOB_SSV_ENABLED=false

# Client build variable: HTTPS origin of the Node game server, without /api.
# VITE_AGENTFC_API_URL=
